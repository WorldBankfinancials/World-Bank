
# ================================================================
# WORLD BANK PRODUCTION ENVIRONMENT VARIABLES
# Copy this to .env for local development
# Add these EXACT values to Vercel Dashboard for production
# ================================================================

# Supabase Database Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key — NEVER commit the real value.
# Add this ONLY via Vercel Dashboard → Settings → Environment Variables
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
NODE_ENV=production
VITE_APP_TITLE="World Bank Digital Banking"

# ================================================================
# DEPLOYMENT INSTRUCTIONS:
# 1. Copy these variables to Vercel Dashboard → Settings → Environment Variables
# 2. Replace placeholder values with your actual Supabase project credentials
# 3. NEVER commit the real .env file to git
# ================================================================
