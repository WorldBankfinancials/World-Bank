
# ================================================================
# WORLD BANK PRODUCTION ENVIRONMENT VARIABLES
# Copy this to .env for local development
# Add these EXACT values to Vercel Dashboard for production
# ================================================================

#DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME
VITE_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Application Configuration
NODE_ENV=production
VITE_APP_TITLE="World Bank Digital Banking"

# ================================================================
# DEPLOYMENT INSTRUCTIONS:
# 1. Copy these variables to Vercel Dashboard → Settings → Environment Variables
# 2. Deploy your app
# 3. Your serverless functions in api/index.js will work automatically
# ================================================================
