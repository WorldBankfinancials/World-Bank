{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist/server",
    "rootDir": ".",
    "noEmit": false,
    "declaration": false,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "server/**/*",
    "api/**/*",
    "shared/**/*"
  ],
  "exclude": [
    "client/**/*",
    "node_modules/**/*",
    "dist/**/*",
    "server/supabase-storage.ts",
    "server/supabase-storage-complete.ts",
    "server/postgres-storage.ts",
    "server/hybrid-postgres-storage.ts",
    "server/unified-sync-storage.ts",
    "server/objectStorage.ts",
    "server/transfer-approval.ts",
    "server/user-creation.ts",
    "server/supabase-mapping.ts",
    "server/vite.ts",
    "vite.config.ts"
  ]
}
