{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/": ["./client/src/"],
      "@shared/": ["./shared/"]
    }
  },
  "include": ["client/src//", "shared//", "server//*"],
  "exclude": ["node_modules", "build", "dist", "/*.test.ts", "server/vite.ts", "vite.config.ts"]
}
